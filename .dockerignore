# Reinstalled/rebuilt inside the image — never copy the host's copies.
node_modules
**/node_modules
dist
**/dist
.output
**/.output
.turbo
**/.turbo
.vite
.vinxi
*.tsbuildinfo

# Secrets & local env — pass real values at runtime via --env-file / -e.
# Match at every level so the apps/web/.env symlink is excluded too.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# VCS / editor / OS cruft
.git
.gitignore
.vscode
.idea
.DS_Store

# Spikes & scratch that don't belong in a build context
apps/web/farmer
apps/web/server.compiled.ts

# The mobile app's generated native projects and Expo caches. Only its
# manifest is needed in the image (see the Dockerfile).
apps/mobile/android
apps/mobile/ios
apps/mobile/.expo

# The relay's SQLite file when it runs from apps/push-relay.
apps/push-relay/data
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal

# Push credentials. Same patterns as .gitignore, at every level: a developer's
# Firebase files, Apple .p8 key or Google service-account key must not enter
# the build context.
**/google-services.json
**/GoogleService-Info.plist
**/*.p8
**/*service-account*.json
**/*-firebase-adminsdk-*.json
**/*.jks
**/*.keystore
**/*.p12
**/*.mobileprovision
