{
	"name": "farmer",
	"private": true,
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/profico/farmer.git"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:check": "turbo run db:check",
		"db:studio": "turbo run db:studio",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"lint": "oxlint",
		"format": "oxfmt --write",
		"check": "oxfmt --check && oxlint"
	},
	"dependencies": {
		"@posthog/react": "1.11.0",
		"posthog-node": "5.52.4"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.80.0",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"turbo": "2.10.4"
	},
	"packageManager": "bun@1.4.2"
}
