{
	"name": "farmer",
	"private": true,
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/profico/farmer.git"
	},
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:check": "turbo run db:check",
		"db:studio": "turbo run db:studio",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"lint": "biome lint",
		"format": "biome format --write",
		"check": "biome check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"turbo": "2.10.4"
	}
}
