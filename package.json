{
	"name": "farmer",
	"private": true,
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/profico/farmer.git"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:check": "turbo run db:check",
		"db:studio": "turbo run db:studio",
		"setup": "bun run scripts/setup.ts",
		"worktree:setup": "bun scripts/worktree-setup.ts",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"lint": "oxlint",
		"format": "oxfmt --write",
		"check": "oxfmt --check && oxlint",
		"complexity": "cccc --top-cognitive 10 . && cccc --top-cyclomatic 10 ."
	},
	"devDependencies": {
		"@oxlint/plugins": "1.80.0",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"turbo": "2.11.10"
	},
	"packageManager": "bun@1.4.2"
}
