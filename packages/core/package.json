{
	"name": "@farmer/core",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		"./db": "./src/db/index.ts",
		"./schema/*": "./src/db/schema/*.ts",
		"./auth": "./src/auth/index.ts",
		"./services": "./src/services/index.ts",
		"./jobs": "./src/jobs/index.ts",
		"./schema": "./src/schema/index.ts",
		"./lib/*": "./src/lib/*.ts",
		"./db/seed-tasks": "./src/db/seed-tasks.ts"
	},
	"scripts": {
		"test": "bun test",
		"lint": "oxlint --config ../../oxlint.config.ts .",
		"format": "oxfmt --write",
		"check": "oxfmt --check && oxlint --config ../../oxlint.config.ts .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"worker": "bun run src/jobs/worker.ts",
		"auth:generate": "better-auth generate --config ./src/auth/index.ts --output ./src/db/schema/auth.ts -y",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:deploy": "bun run src/db/migrate.ts",
		"db:check": "bun run src/db/check.ts",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun run src/db/seed.ts",
		"db:seed-tasks": "bun run src/db/seed-tasks.ts",
		"db:seed-assistant-ui": "bun run src/db/seed-assistant-ui.ts"
	},
	"dependencies": {
		"@date-fns/tz": "1.5.0",
		"better-auth": "1.6.23",
		"date-fns": "4.4.0",
		"date-holidays": "3.32.0",
		"drizzle-orm": "0.45.2",
		"nodemailer": "9.0.3",
		"postgres": "3.4.9",
		"web-push": "3.6.7",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@better-auth/cli": "1.4.21",
		"@electric-sql/pglite": "0.5.4",
		"@types/nodemailer": "8.0.1",
		"@types/web-push": "3.6.4",
		"bun-types": "1.3.14",
		"drizzle-kit": "0.31.10",
		"typescript": "^6.0.2"
	}
}
