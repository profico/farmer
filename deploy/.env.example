# Copy this file to .env in the same folder as compose.yml. See docs/self-hosting.md.

# Required: the password of the database. Use a long random value without
# the characters : / @ ? # % (they break the database URL).
POSTGRES_PASSWORD=

# Required: signs the sessions and seals every stored secret. Make it with
# "openssl rand -hex 32". Keep it: a new value makes the stored secrets
# unreadable.
BETTER_AUTH_SECRET=

# Required: the public origin of this instance, with no path at the end.
BETTER_AUTH_URL=https://farmer.example.com

# Optional: the image tag. Use X.Y.Z, X.Y, X, latest (a release) or nightly.
# FARMER_VERSION=latest

# Optional: the image repository. Change it for a fork or a local build.
# FARMER_IMAGE=ghcr.io/profico/farmer

# Optional: the port on the host (the loopback address only).
# FARMER_PORT=3000

# Optional: the header in which your reverse proxy sends the client address.
# Use x-forwarded-for, x-real-ip, cf-connecting-ip or none.
# TRUSTED_IP_HEADER=none
