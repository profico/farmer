# Postgres — `docker compose up -d` provides exactly this one.
DATABASE_URL=postgres://farmer:farmer@localhost:5433/farmer

# Session signing secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Everything below is optional — leave empty until you want the feature.

# Single-organization mode. Set this to a slug (e.g. `acme`) to turn the
# deployment into a one-workspace instance: nobody can create a second
# organization, signup is invitation-only, `/` is the app instead of the
# marketing page, and the login screen wears that organization's name and logo.
# Leave it empty for the normal multi-tenant product.
#
# The organization does not have to exist yet — the first person to register on
# a fresh instance creates it under this slug and becomes its owner. Everyone
# after that needs an invitation. Rename the workspace (and set its logo) in
# Settings → Organization; the login screen follows.
#
# Changing the slug later points the instance at a *different* organization, so
# treat it as fixed once anyone has signed up.
SINGLE_ORG_SLUG=

# SMTP — organization invite emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Farmer <you@example.com>"

# GitHub OAuth app (per-user account link — identity + commit authorship).
# Callback URL in the OAuth app: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (per-org installation — repo & commit access).
# Setup URL in the App config: {BETTER_AUTH_URL}/api/github/setup
# GITHUB_APP_PRIVATE_KEY is the base64-encoded PEM (base64 -w0 < app.private-key.pem).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# Slack app (per-org install — reminder DMs). Create one app at api.slack.com,
# under "OAuth & Permissions" add the bot scopes chat:write, im:write,
# users:read and users:read.email, and add this exact Redirect URL:
#   {BETTER_AUTH_URL}/api/slack/callback
# Enable "Distribute App" if orgs other than your own will install it. Admins
# then click "Add to Slack" on the Integrations page — no token is ever pasted.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Google OAuth (per-user account link — Calendar read for meeting autofill).
# Redirect URI in Google Cloud: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production server (apps/web/server.ts) only — dev ignores this.
PORT=3000

# Background jobs. These are read by the scheduler wherever it runs: in the
# production web host, in the standalone worker (`bun run worker` from
# packages/core), and in the worker `vite dev` spawns for you.
#
# The automation sweep is what materializes recurring blocks and imports
# meetings and commit work-time blocks — none of that happens on page load, so
# turning it off means those entries never appear.
AUTOMATION_SYNC_ENABLED=true
AUTOMATION_SYNC_INTERVAL_MINUTES=20
# How many people the sweep syncs at once. Small on purpose — the ceiling is
# Google's and GitHub's rate limits, not this machine.
# AUTOMATION_SYNC_CONCURRENCY=4
# How long one person's pass may take before the sweep gives up on it and moves
# on. Abandoned work keeps running and is harmless; every engine is idempotent.
# AUTOMATION_SYNC_USER_TIMEOUT_MS=120000

# Deadline on every outbound call to Google, GitHub and Slack. `fetch` has no
# default timeout, and a socket that opens and never answers used to wedge the
# scheduler permanently: the tick never finished, so no later tick could start.
# EXTERNAL_FETCH_TIMEOUT_MS=15000

# Set to false to keep `vite dev` from spawning a worker (e.g. you're running
# `bun run worker` yourself).
#
# NOTE: the dev worker runs the automation sweep ONLY. Log reminders, Slack
# nudges and budget alerts all message real people, and dev usually points at a
# shared or restored database full of real addresses — set the matching
# *_ENABLED=true here if you actually need to work on one of them.
# DEV_WORKER=false
