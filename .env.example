# Postgres — `docker compose up -d` provides exactly this one.
DATABASE_URL=postgres://farmer:farmer@localhost:5433/farmer

# Session signing secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# There is no NODE_ENV setting here on purpose, but it is worth knowing what it
# does: anything other than `production` turns on email + password sign-in, so a
# fresh checkout can be logged into without a Google Cloud project. `/login`
# then renders a form under the Google button instead of bouncing straight to
# Google. The Dockerfile and `bun run start` both set NODE_ENV=production, so
# every supported way of serving this app has password sign-in OFF — but if you
# host it some third way, set it there too.

# Everything below is optional — leave empty until you want the feature.

# Single-organization mode. Set this to a slug (e.g. `acme`) to turn the
# deployment into a one-workspace instance: nobody can create a second
# organization, signup is invitation-only, `/` is the app instead of the
# marketing page, and the login screen wears that organization's name and logo.
# Leave it empty for the normal multi-tenant product.
#
# The organization does not have to exist yet — the first person to register on
# a fresh instance creates it under this slug and becomes its owner. Everyone
# after that needs an invitation. Rename the workspace (and set its logo) in
# Settings → Organization; the login screen follows.
#
# Changing the slug later points the instance at a *different* organization, so
# treat it as fixed once anyone has signed up.
SINGLE_ORG_SLUG=

# File uploads — project icons and organization logos — in an S3-compatible
# store. `docker compose up -d` runs Garage with exactly these values; a
# deployment points them at its own Garage, or at any other S3 service. With any
# of the four required values empty, nothing offers an upload, and icons and
# logos stay emoji and pasted URLs.
#
# The bucket stays private. The app reads it and serves every file itself at
# /api/files/…, so neither a public bucket nor a website endpoint is needed.
# S3_REGION must match the store's own (Garage: `s3_region` in garage.toml).
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=farmer
S3_ACCESS_KEY_ID=GK0f4a1c2e3b5d6a7f8e9c0b1d
S3_SECRET_ACCESS_KEY=9d8c7b6a5f4e3d2c1b0a9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c

# Email — organization invite emails, through Resend or SMTP.
# With only one configured, that one is used. With both, Resend is used unless
# EMAIL_PROVIDER says otherwise ("resend" or "smtp"). With neither, invitations
# are still created, and the members page marks their email as failed.
EMAIL_PROVIDER=
# The sender for either provider. With Resend it must be on a verified domain.
# Falls back to SMTP_FROM, then SMTP_USER.
EMAIL_FROM="Farmer <you@example.com>"

# Resend (https://resend.com/api-keys).
RESEND_API_KEY=

# SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# GitHub OAuth app (per-user account link — identity + commit authorship).
# Callback URL in the OAuth app: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (per-org installation — repo & commit access).
# Setup URL in the App config: {BETTER_AUTH_URL}/api/github/setup
# GITHUB_APP_PRIVATE_KEY is the base64-encoded PEM (base64 -w0 < app.private-key.pem).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# Slack app (per-org install — reminder DMs). Create one app at api.slack.com,
# under "OAuth & Permissions" add the bot scopes chat:write, im:write,
# users:read and users:read.email, and add this exact Redirect URL:
#   {BETTER_AUTH_URL}/api/slack/callback
# Enable "Distribute App" if orgs other than your own will install it. Admins
# then click "Add to Slack" on the Integrations page — no token is ever pasted.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Google OAuth (per-user account link — Calendar read for meeting autofill).
# Redirect URI in Google Cloud: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production server (apps/web/server.ts) only — dev ignores this.
PORT=3000

# Static asset preloading in the production server. Eight ASSET_PRELOAD_*
# variables (size ceiling, include/exclude globs, ETag, gzip) are documented,
# with their defaults, in the header of apps/web/server.ts. The defaults suit
# the Docker image; leave them unset unless you are tuning memory.

# How long a shutdown waits for in-flight scheduler ticks before it exits, in
# both the web host and the standalone worker.
# SHUTDOWN_GRACE_MS=10000

# Docker entrypoint only. The image applies pending migrations (under an
# advisory lock) and seeds the built-in absence tasks on every boot; both are
# safe to repeat. Set to false when a separate step already does them.
# RUN_MIGRATIONS=true
# RUN_SEED=true

# Postgres pool. Set DATABASE_PREPARE=false when a transaction-mode pooler
# (PgBouncer, Supabase's pooler) sits in front, because it cannot keep a
# prepared statement across connections. Timeouts are in seconds.
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT=30
# DATABASE_CONNECT_TIMEOUT=10
# DATABASE_PREPARE=true

# Feature switches for this deployment. Both default ON and are independent:
# turning the assistant off leaves the MCP server working, and the other way
# round. Plain variables, not VITE_ ones, so one image serves every environment.
#
# ASSISTANT_ENABLED=false removes the assistant: no nav row, no route, a 404
# from its stream endpoint. An admin can still remove the stored OpenRouter key.
# MCP_ENABLED=false makes /api/mcp/<org-slug> answer 404.
# ASSISTANT_ENABLED=true
# MCP_ENABLED=true

# OpenRouter (the assistant). The API key is per organization and set by an
# admin in the app, never here. These only label the requests and bound a
# streamed answer; the stream timeout covers the WHOLE answer, not the connect.
# OPENROUTER_APP_URL=https://farmer.app
# OPENROUTER_APP_TITLE=Farmer
# OPENROUTER_STREAM_TIMEOUT_MS=180000

# Background jobs. These are read by the scheduler wherever it runs: in the
# production web host, in the standalone worker (`bun run worker` from
# packages/core), and in the worker `vite dev` spawns for you.
#
# The automation sweep is what materializes recurring blocks and imports
# meetings and commit work-time blocks — none of that happens on page load, so
# turning it off means those entries never appear.
AUTOMATION_SYNC_ENABLED=true
AUTOMATION_SYNC_INTERVAL_MINUTES=20
# How many people the sweep syncs at once. Small on purpose — the ceiling is
# Google's and GitHub's rate limits, not this machine.
# AUTOMATION_SYNC_CONCURRENCY=4
# How long one person's pass may take before the sweep gives up on it and moves
# on. Abandoned work keeps running and is harmless; every engine is idempotent.
# AUTOMATION_SYNC_USER_TIMEOUT_MS=120000
# How many repositories one person's commit scan reads at once.
# GITHUB_REPO_SCAN_CONCURRENCY=4

# The other three jobs. All default to ON wherever the scheduler runs, which is
# every environment except `vite dev` (see DEV_WORKER below) — so these are the
# switches to set to `false` on a web host that has a separate worker container,
# not switches to turn anything on.
#
# Both message real people: log reminders send email and push, Slack reminders
# DM the workspace.
# LOG_REMINDERS_ENABLED=true
# LOG_REMINDERS_INTERVAL_MINUTES=30
# SLACK_REMINDERS_ENABLED=true
# SLACK_REMINDERS_INTERVAL_MINUTES=60
# The log reminder sweep: people reminded at once, and how long one person may
# take before the sweep moves on.
# LOG_REMINDERS_CONCURRENCY=4
# LOG_REMINDERS_USER_TIMEOUT_MS=30000
# How long after boot the first tick fires, so a deploy doesn't sweep while the
# process is still warming up.
# SCHEDULER_STARTUP_DELAY_MS=15000

# Deadline on every outbound call to Google, GitHub and Slack. `fetch` has no
# default timeout, and a socket that opens and never answers used to wedge the
# scheduler permanently: the tick never finished, so no later tick could start.
# EXTERNAL_FETCH_TIMEOUT_MS=15000

# Web push (browser notifications). Generate a key pair with:
#   bunx web-push generate-vapid-keys
#
# Optional, and it fails QUIETLY when it isn't set: `notificationsService.
# sendPush` becomes a no-op, so the app works, the UI still offers to enable
# notifications, and nothing is ever delivered. If push looks broken in a
# deployment, check here first.
#
# VAPID_SUBJECT must be a mailto: or https: URL identifying you to the push
# service; it defaults to a placeholder that real push services may reject.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Set to false to keep `vite dev` from spawning a worker (e.g. you're running
# `bun run worker` yourself).
#
# NOTE: the dev worker runs the automation sweep ONLY. Log reminders and Slack
# nudges both message real people, and dev usually points at a
# shared or restored database full of real addresses — set the matching
# *_ENABLED=true here if you actually need to work on one of them.
# DEV_WORKER=false
