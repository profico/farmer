# Farmer reads three values to start, and five in production. Everything else
# is optional: an operational value with a default, or a setting that a
# platform admin sets on the Infrastructure pages (Settings -> Infrastructure).
#
# `bun run setup` copies this file to .env and fills in BETTER_AUTH_SECRET.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres. `docker compose up -d` provides exactly this one.
DATABASE_URL=postgres://farmer:farmer@localhost:5433/farmer

# Signs the sessions, and is the root key that seals every stored secret (the
# settings below, OAuth tokens, API keys). Generate it with:
#   openssl rand -hex 32
# Keep it. A new value makes every sealed secret unreadable. To rotate it, keep
# this one and add the new secret first in a versioned list, for example
# BETTER_AUTH_SECRETS=2:<new>,1:<old>. See docs/domains/deployment.md.
BETTER_AUTH_SECRET=
# BETTER_AUTH_SECRETS=

# The public origin of this deployment. Every OAuth callback URL is built from
# it, and the Infrastructure pages show them as {origin}.
BETTER_AUTH_URL=http://localhost:3000

# In production, also set these two. The Dockerfile and `bun run start` set
# NODE_ENV=production for you. `bun run dev` sets NODE_ENV=development, which
# turns on email and password sign-in for any account, so a fresh checkout
# needs no identity provider.
# NODE_ENV=production
# PORT=3000

# ---------------------------------------------------------------------------
# Settings: set these on the Infrastructure pages, not here
# ---------------------------------------------------------------------------
#
# Each name below is also a setting on Settings -> Infrastructure. The first
# account on a new instance is the platform admin, and sets them there.
#
# A value set here WINS over the page and locks its field, with "Set by the
# environment" (docs/adr/0004-environment-overrides-the-database.md). Use that
# to pin a value in a deploy manifest. An empty value counts as not set.
# To move an existing deployment from here to the pages, see
# docs/plans/instance-settings-migration.md.

# Sign-in (Infrastructure -> Sign-in). Any OpenID Connect provider is added on
# that page, not here.
# REGISTRATION_OPEN=false
# SINGLE_ORG_SLUG=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email (Infrastructure -> Email): Resend or SMTP.
# EMAIL_PROVIDER=
# EMAIL_FROM="Farmer <you@example.com>"
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_REQUIRE_TLS=true   # false: allow plain SMTP to a relay on a trusted network
# SMTP_FROM=

# Uploads (Infrastructure -> Storage): any S3-compatible store. The values
# below are the ones for the Garage that `docker compose up -d` runs. Type them
# on the page, or remove the `# ` to set them here (which locks the fields).
# S3_ENDPOINT=http://localhost:3900
# S3_REGION=garage
# S3_BUCKET=farmer
# S3_ACCESS_KEY_ID=GK0f4a1c2e3b5d6a7f8e9c0b1d
# S3_SECRET_ACCESS_KEY=9d8c7b6a5f4e3d2c1b0a9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c3b2a1f0e9d8c

# GitHub App and Slack app (Infrastructure -> Integrations). The page shows
# each URL to register. GITHUB_APP_PRIVATE_KEY takes the PEM or its base64.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# Features (Infrastructure -> Features). The three feature switches default
# on. HOMEPAGE_ENABLED defaults off: / then opens the workspace instead of the
# Farmer product page, which only the public farmer deployment wants.
# CLI_RELEASES_REPO is owner/name on GitHub: the CLI downloads, the
# contributors card and the "Report a problem" link all use it. A fork sets it
# to its own repository. CLI_ENABLED also switches the REST API and the
# personal API tokens (Preferences -> API tokens).
# HOMEPAGE_ENABLED=false
# ASSISTANT_ENABLED=true
# MCP_ENABLED=true
# CLI_ENABLED=true
# CLI_RELEASES_REPO=profico/farmer

# Web push. Make a key pair with: bunx web-push generate-vapid-keys
# Without it, push is a silent no-op: the UI offers notifications and nothing
# is delivered.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# PostHog. The project token is public (it ships in the page), so never put a
# personal API key here. POSTHOG_AI_CAPTURE_CONTENT=true copies the assistant's
# and the MCP server's prompts, answers and tool results to PostHog: that is
# people's timesheets. It is off unless somebody turns it on.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=
# POSTHOG_AI_CAPTURE_CONTENT=false

# ---------------------------------------------------------------------------
# Operational: optional, with defaults
# ---------------------------------------------------------------------------
#
# These stay in the environment only. A web container and a worker container
# need different values out of one database, so they are not settings.

# Static asset preloading in the production server. Eight ASSET_PRELOAD_*
# variables (size ceiling, include/exclude globs, ETag, gzip) are documented,
# with their defaults, in the header of apps/web/server.ts. The defaults suit
# the Docker image; leave them unset unless you are tuning memory.

# The largest request body the production server reads (bytes); a larger one
# gets a 413 before any handler runs. The default, 32MB, holds about five
# times the largest Harvest import step with long notes. Raise it only if an
# import fails with 413. See MAX_REQUEST_BODY_BYTES in apps/web/server.ts.
# MAX_REQUEST_BODY_BYTES=33554432

# The ONE request header the per-address rate limits (MCP server, CLI API)
# read the client's address from; no other header is trusted. The default,
# cf-connecting-ip, is right behind Cloudflare, which overwrites it. Use
# x-real-ip for a proxy that overwrites that one, x-forwarded-for to read its
# LAST entry (the one the nearest proxy appended), or none for the socket
# address only. Missing header: the socket address. It is only as good as the
# one way in, so keep the origin reachable only through the proxy.
# TRUSTED_IP_HEADER=cf-connecting-ip

# How long a shutdown waits for in-flight scheduler ticks before it exits, in
# both the web host and the standalone worker.
# SHUTDOWN_GRACE_MS=10000

# Docker entrypoint only. The image applies pending migrations (under an
# advisory lock) and seeds the built-in absence tasks on every boot; both are
# safe to repeat. Set to false when a separate step already does them.
# RUN_MIGRATIONS=true
# RUN_SEED=true

# Postgres pool. Set DATABASE_PREPARE=false when a transaction-mode pooler
# (PgBouncer, Supabase's pooler) sits in front, because it cannot keep a
# prepared statement across connections. Timeouts are in seconds.
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT=30
# DATABASE_CONNECT_TIMEOUT=10
# DATABASE_PREPARE=true

# The commit this build is running, shown under that card. CI passes it as a
# Docker build argument (GIT_SHA=${{ github.sha }}); set it by hand only if you
# build the image yourself. Off a build, development reads .git directly, so
# there is nothing to set locally.
#
# Coolify's own SOURCE_COMMIT is read as a second source, and it is not the same
# thing: GIT_SHA is baked into the image, so an image built before that build
# argument existed cannot report a commit however it is deployed, while
# SOURCE_COMMIT is set on the deployment and answers for exactly that case.
# Nothing to set for it either - the platform provides it.
# GIT_SHA=

# OpenRouter (the assistant). The API key is per organization and set by an
# admin in the app, never here. These only label the requests and bound a
# streamed answer; the stream timeout covers the WHOLE answer, not the connect.
# OPENROUTER_APP_URL=https://farmer.app
# OPENROUTER_APP_TITLE=Farmer
# OPENROUTER_STREAM_TIMEOUT_MS=180000

# Background jobs. These are read by the scheduler wherever it runs: in the
# production web host, in the standalone worker (`bun run worker` from
# packages/core), and in the worker `vite dev` spawns for you.
#
# The automation sweep is what materializes recurring blocks and imports
# meetings and commit work-time blocks — none of that happens on page load, so
# turning it off means those entries never appear.
# AUTOMATION_SYNC_ENABLED=true
# AUTOMATION_SYNC_INTERVAL_MINUTES=20
# How many people the sweep syncs at once. Small on purpose — the ceiling is
# Google's and GitHub's rate limits, not this machine.
# AUTOMATION_SYNC_CONCURRENCY=4
# How long one person's pass may take before the sweep gives up on it and moves
# on. Abandoned work keeps running and is harmless; every engine is idempotent.
# AUTOMATION_SYNC_USER_TIMEOUT_MS=120000
# How many repositories one person's commit scan reads at once.
# GITHUB_REPO_SCAN_CONCURRENCY=4

# The other four jobs. All default to ON wherever the scheduler runs, which is
# every environment except `vite dev` (see DEV_WORKER below) — so these are the
# switches to set to `false` on a web host that has a separate worker container,
# not switches to turn anything on.
#
# Both message real people: log reminders send email and push, Slack reminders
# DM the workspace.
# LOG_REMINDERS_ENABLED=true
# LOG_REMINDERS_INTERVAL_MINUTES=30
# SLACK_REMINDERS_ENABLED=true
# SLACK_REMINDERS_INTERVAL_MINUTES=15
# The timer sweep drops a stopwatch that has run past the limit its owner set
# (Settings -> Preferences, 12 hours by default). It logs NOTHING: a figure
# nobody chose is what the stopwatch was designed not to produce. Turning it
# off lets a forgotten timer run for ever.
# TIMER_SWEEP_ENABLED=true
# TIMER_SWEEP_INTERVAL_MINUTES=15
# The upload sweep deletes uploaded images that no project icon or organization
# logo uses, once they are a day old. Does nothing without the S3 settings.
# UPLOAD_SWEEP_ENABLED=true
# UPLOAD_SWEEP_INTERVAL_MINUTES=1440
# The audit sweep deletes audit log rows older than each workspace keeps them
# (Settings -> Audit log, one year by default).
# AUDIT_SWEEP_ENABLED=true
# AUDIT_SWEEP_INTERVAL_MINUTES=1440
# The log reminder sweep: people reminded at once, and how long one person may
# take before the sweep moves on.
# LOG_REMINDERS_CONCURRENCY=4
# LOG_REMINDERS_USER_TIMEOUT_MS=30000
# Outbound webhooks (Settings -> Webhooks). The job turns the event outbox into
# signed POSTs to whatever URL an admin registered. Setting ENABLED to `false`
# stops the sending AND stops the services writing events at all, so a
# deployment that does not want the feature pays nothing for it.
#
# WEBHOOK_DELIVERY_ENABLED=true
# WEBHOOK_DELIVERY_INTERVAL_MINUTES=1
# WEBHOOK_DELIVERY_TIMEOUT_MS=10000

# Let a webhook reach a private address.
#
# OFF, and think before turning it on. The URL is typed by a person and the call
# is made by this process, which can reach your database, your object store and
# — on a managed host — the metadata endpoint that hands out cloud credentials
# to anything asking from inside. With this off, `https://` is required and
# every address is checked after DNS on every attempt: loopback, private,
# link-local (169.254.169.254), and their IPv6 disguises are refused.
#
# Turn it on only on a self-hosted deployment whose receiver genuinely is on the
# same private network. It also allows plain `http://`.
# WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# How long after boot the first tick fires, so a deploy doesn't sweep while the
# process is still warming up.
# SCHEDULER_STARTUP_DELAY_MS=15000

# Deadline on every outbound call to Google, GitHub and Slack. `fetch` has no
# default timeout, and a socket that opens and never answers used to wedge the
# scheduler permanently: the tick never finished, so no later tick could start.
# EXTERNAL_FETCH_TIMEOUT_MS=15000

# Set to false to keep `vite dev` from spawning a worker (e.g. you're running
# `bun run worker` yourself).
#
# NOTE: the dev worker runs the automation sweep ONLY. Log reminders and Slack
# nudges both message real people, and dev usually points at a
# shared or restored database full of real addresses — set the matching
# *_ENABLED=true here if you actually need to work on one of them.
# DEV_WORKER=false
