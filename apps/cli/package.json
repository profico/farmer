{
	"name": "@farmer/cli",
	"version": "0.4.0",
	"private": true,
	"license": "Apache-2.0",
	"bin": {
		"farmer": "./src/main.ts"
	},
	"type": "module",
	"scripts": {
		"start": "bun run src/main.ts",
		"build": "bun run scripts/build.ts",
		"build:release": "bun run scripts/build.ts --release",
		"test": "bun test",
		"lint": "oxlint --config ../../oxlint.config.ts .",
		"format": "oxfmt --write",
		"check": "oxfmt --check && oxlint --config ../../oxlint.config.ts .",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@clack/prompts": "1.8.1",
		"@farmer/core": "workspace:*",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"bun-types": "1.4.2",
		"typescript": "^6.0.2"
	}
}
