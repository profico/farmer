{
	"name": "web",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"check:palette": "bun run scripts/check-palette-contrast.ts",
		"build": "vite build && bun run scripts/prune-client-assets.ts",
		"start": "NODE_ENV=production bun run server.ts",
		"preview": "vite preview",
		"test": "bun test --isolate",
		"format": "oxfmt --write",
		"lint": "oxlint --config ../../oxlint.config.ts .",
		"check": "oxfmt --check && oxlint --config ../../oxlint.config.ts .",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@farmer/core": "workspace:*",
		"@hookform/resolvers": "5.4.0",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@phosphor-icons/react": "2.1.10",
		"@posthog/mcp": "0.25.0",
		"@scalar/api-reference-react": "0.9.87",
		"@tailwindcss/vite": "^4.3.4",
		"@tanstack/react-devtools": "0.10.14",
		"@tanstack/react-query": "5.105.3",
		"@tanstack/react-query-devtools": "5.105.3",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.4",
		"better-auth": "1.7.15",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "0.45.4",
		"emojibase-data": "17.0.0",
		"jspdf": "4.2.1",
		"jspdf-autotable": "5.0.9",
		"motion": "12.42.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "7.91.0",
		"sonner": "2.0.8",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "20.14.5",
		"@tanstack/devtools-vite": "0.8.6",
		"@tanstack/router-cli": "^1.167.46",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.2.1",
		"bun-types": "1.4.4",
		"typescript": "^6.0.2",
		"vite": "^8.3.5"
	}
}
