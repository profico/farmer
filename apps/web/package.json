{
	"name": "web",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build && bun run scripts/prune-client-assets.ts",
		"start": "NODE_ENV=production bun run server.ts",
		"preview": "vite preview",
		"format": "oxfmt --write",
		"lint": "oxlint --config ../../oxlint.config.ts .",
		"check": "oxfmt --check && oxlint --config ../../oxlint.config.ts .",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@base-ui/react": "1.6.0",
		"@farmer/core": "workspace:*",
		"@hookform/resolvers": "5.4.0",
		"@myriaddreamin/typst-ts-node-compiler": "0.7.0",
		"@phosphor-icons/react": "2.1.10",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.8",
		"@tanstack/react-query": "5.101.2",
		"@tanstack/react-query-devtools": "5.101.2",
		"@tanstack/react-router": "1.170.17",
		"@tanstack/react-router-devtools": "1.167.0",
		"@tanstack/react-router-ssr-query": "1.167.1",
		"@tanstack/react-start": "1.168.27",
		"better-auth": "1.6.23",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "0.45.2",
		"motion": "12.42.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "7.81.0",
		"sonner": "2.0.7",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@tanstack/devtools-vite": "0.8.1",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"bun-types": "1.3.14",
		"typescript": "^6.0.2",
		"vite": "^8.0.0"
	}
}
