{
	"name": "@farmer/site",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3100",
		"build": "bun run scripts/fetch-releases.ts && vite build",
		"start": "NODE_ENV=production bun run server.ts",
		"test": "bun test",
		"format": "oxfmt --write",
		"lint": "oxlint --config ../../oxlint.config.ts .",
		"check": "oxfmt --check && oxlint --config ../../oxlint.config.ts .",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@phosphor-icons/react": "2.1.10",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"bun-types": "1.4.4",
		"tailwindcss": "4.3.5",
		"typescript": "^6.0.2",
		"vite": "8.3.7"
	}
}
